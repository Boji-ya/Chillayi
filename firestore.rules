rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: own data only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read collections
    match /places/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /restaurants/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hotels/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /missions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /shops/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
